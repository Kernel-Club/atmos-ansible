# Managed by Ansible (roles/k3s). k3s reads this file at start; changes here are overwritten.
node-name: {{ inventory_hostname }}
node-ip: {{ ansible_host }}
flannel-iface: {{ k3s_interface }}
{% if inventory_hostname in groups['k3s_server'] %}
# Names and addresses of the API server certificate (kubectl from the Mac).
tls-san:
  - {{ ansible_host }}
  - {{ inventory_hostname }}
write-kubeconfig-mode: "0600"
{% else %}
# The server to join; the token is in its own file, not here.
server: https://{{ k3s_api_host }}:{{ k3s_api_port }}
token-file: {{ k3s_token_file }}
{% endif %}
