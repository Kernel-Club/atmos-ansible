# Managed by Ansible (roles/k3s). Pods do not read /etc/hosts of the node,
# so the names served by Traefik on nexus-traefik are added to CoreDNS of the cluster:
# the registry (Flux, Prometheus for Nexus) and Jenkins (Prometheus).
apiVersion: v1
kind: ConfigMap
metadata:
  name: coredns-custom
  namespace: kube-system
data:
  registry.server: |
    {{ registry_name }}:53 {
      hosts {
        {{ hostvars[registry_host].ansible_host }} {{ registry_name }}
      }
    }
  jenkins.server: |
    {{ jenkins_name }}:53 {
      hosts {
        {{ hostvars[traefik_host].ansible_host }} {{ jenkins_name }}
      }
    }
