# Managed by Ansible (roles/nexus). Changes here are overwritten.
name: nexus

services:
  nexus:
    image: {{ nexus_image }}
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ nexus_http_port }}:8081"    # 8081: port of Nexus inside the container
      - "127.0.0.1:{{ nexus_registry_port }}:{{ nexus_registry_port }}"
    environment:
      INSTALL4J_ADD_VM_PARAMS: "{{ nexus_jvm_options }}"
    volumes:
      - nexus-data:/nexus-data
    deploy:
      resources:
        limits:
          memory: {{ nexus_memory_limit }}

volumes:
  nexus-data:
