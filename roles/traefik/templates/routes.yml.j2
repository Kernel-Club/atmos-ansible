# Dynamic configuration of Traefik (routes and certificate). Managed by Ansible (roles/traefik).
# Traefik reloads this file by itself.

http:
  routers:
    jenkins:
      rule: Host(`{{ jenkins_name }}`)
      entryPoints: [websecure]
      service: jenkins
      tls: {}
    nexus:
      rule: Host(`{{ nexus_name }}`)
      entryPoints: [websecure]
      service: nexus
      tls: {}
    registry:
      rule: Host(`{{ registry_name }}`)
      entryPoints: [registry]
      service: registry
      tls: {}
    # Metrics of Jenkins answer without login, so only Prometheus in the cluster may read them.
    # A longer rule wins over the jenkins router above.
    jenkins-metrics:
      rule: Host(`{{ jenkins_name }}`) && PathPrefix(`/prometheus`)
      entryPoints: [websecure]
      middlewares: [cluster-nodes-only]
      service: jenkins
      tls: {}

    # Webhook of Flux (notification-controller in the cluster) that starts develop-cd-checks after a deploy.
    # The token is checked by Jenkins; the path is reachable only from the cluster nodes as well.
    jenkins-webhook:
      rule: Host(`{{ jenkins_name }}`) && PathPrefix(`/generic-webhook-trigger`)
      entryPoints: [websecure]
      middlewares: [cluster-nodes-only]
      service: jenkins
      tls: {}

  middlewares:
    cluster-nodes-only:
      ipAllowList:
        sourceRange:
{% for host in groups['k3s'] %}
          - {{ hostvars[host].ansible_host }}
{% endfor %}

  services:
    jenkins:
      loadBalancer:
        servers:
          - url: {{ traefik_jenkins_url }}
    nexus:
      loadBalancer:
        servers:
          - url: {{ traefik_nexus_url }}
    registry:
      loadBalancer:
        servers:
          - url: {{ traefik_registry_url }}

tls:
  stores:
    default:
      defaultCertificate:
        certFile: /etc/traefik/certs/{{ pki_server_cert | basename }}
        keyFile: /etc/traefik/certs/{{ pki_server_key | basename }}
