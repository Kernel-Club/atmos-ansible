# Static configuration of Traefik. Managed by Ansible (roles/traefik). A change restarts Traefik.

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"
  registry:
    address: ":{{ registry_port }}"
    transport:
      respondingTimeouts:
        readTimeout: 0s         # large image layers can take longer than the default 60 s
  metrics:
    address: ":{{ traefik_metrics_port }}"   # only Prometheus metrics; ufw: cluster nodes only

# Prometheus metrics with labels per entry point, router and service (Jenkins, Nexus, registry).
metrics:
  prometheus:
    entryPoint: metrics
    addRoutersLabels: true

providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true                 # routes are reloaded without a restart

log:
  level: INFO
