# Managed by Ansible (roles/traefik). Changes here are overwritten.
name: traefik

services:
  traefik:
    image: {{ traefik_image }}
    restart: unless-stopped
    network_mode: host          # ports on the server itself, so ufw applies
    volumes:
      - ./traefik.yml:/etc/traefik/traefik.yml:ro
      - ./dynamic:/etc/traefik/dynamic:ro
      - ./certs:/etc/traefik/certs:ro
    deploy:
      resources:
        limits:
          memory: {{ traefik_memory_limit }}
